{
  "platform": {
    "os": "Windows 10/11 x64 or macOS 13+",
    "powershell": ">=5.1 on Windows",
    "python": ">=3.11,<3.15",
    "powerPoint": "Windows and macOS: native editable OOXML by default; Windows COM opt-in for simple paths",
    "powerPointProgId": "PowerPoint.Application",
    "macBackend": "editable-ooxml",
    "wps": "experimental",
    "illustrator": "Windows COM / macOS AppleScript, active Illustrator document; macOS implementation requires desktop validation"
  },
  "pythonDependencies": {
    "python-pptx": "1.0.2",
    "fonttools": "4.61.1",
    "shapely": "2.1.2"
  },
  "codex": {
    "requiresDesktopApp": true,
    "requiresBuiltInImage2": false,
    "skillId": "cell_su7"
